    local function trajectory(p0, v0, t, use_gravity, floor_y, turn)
        local p, v
        if use_gravity then
            local gy = gk_state.traj_gravity
            local x, z, vx, vz
            local ang = (turn or 0) * t
            if math.abs(ang) > 1e-4 then
                local s = math.sin(ang)
                local c = math.cos(ang)
                x = p0.X + (v0.X * s - v0.Z * (1 - c)) / turn
                z = p0.Z + (v0.X * (1 - c) + v0.Z * s) / turn
                vx = v0.X * c - v0.Z * s
                vz = v0.X * s + v0.Z * c
            else
                x = p0.X + v0.X * t
                z = p0.Z + v0.Z * t
                vx = v0.X
                vz = v0.Z
            end
            p = Vector3.new(x, p0.Y + v0.Y * t + 0.5 * gy * t * t, z)
            v = Vector3.new(vx, v0.Y + gy * t, vz)
        else
            p = p0 + v0 * t
            v = v0
        end
        if floor_y and p.Y < floor_y then
            p = Vector3.new(p.X, floor_y, p.Z)
        end
        return p, v
    end

    local function update_curve(ball, dt, floor_y)
        local hist = gk_state.hist
        local now = os.clock()
        local pos = ball.Position
        local raw = ball.AssemblyLinearVelocity
        local last = hist[#hist]
        if last and (raw - last.vel).Magnitude > gk_state.hist_reset_dv then
            table.clear(hist)
            last = nil
        end
        if not last or (pos - last.pos).Magnitude > 0.001 then
            hist[#hist + 1] = {t = now, pos = pos, vel = raw}
        end
        while #hist > 0 and now - hist[1].t > gk_state.hist_window do
            table.remove(hist, 1)
        end

        local n = #hist
        if n < 4 or hist[n].t - hist[1].t < gk_state.hist_min_span then
            gk_state.turn = 0
            return nil
        end

        local span = hist[n].t - hist[1].t
        local mid = hist[1].t + span * 0.5
        local split = 1
        for i = 1, n do
            if hist[i].t <= mid then split = i end
        end
        if split < 2 or n - split < 1 then
            gk_state.turn = 0
            return nil
        end

        local old_dt = hist[split].t - hist[1].t
        local new_dt = hist[n].t - hist[split].t
        if old_dt < 0.02 or new_dt < 0.02 then
            gk_state.turn = 0
            return nil
        end

        local v_old = (hist[split].pos - hist[1].pos) / old_dt
        local v_new = (hist[n].pos - hist[split].pos) / new_dt
        local t_old = (hist[1].t + hist[split].t) * 0.5
        local t_new = (hist[split].t + hist[n].t) * 0.5
        local g = t_new - t_old
        if g < 0.02 then
            gk_state.turn = 0
            return nil
        end

        local turn = 0
        local ah = Vector3.new(v_old.X, 0, v_old.Z)
        local bh = Vector3.new(v_new.X, 0, v_new.Z)
        if ah.Magnitude > 5 and bh.Magnitude > 5 then
            local da = math.atan2(bh.Z, bh.X) - math.atan2(ah.Z, ah.X)
            da = (da + math.pi) % (2 * math.pi) - math.pi
            turn = math.clamp(da / g, -gk_state.max_turn, gk_state.max_turn)
        end

        local a = 1 - math.exp(-dt * gk_state.curve_smooth_rate)
        gk_state.turn = gk_state.turn + (turn - gk_state.turn) * a

        local lag = math.max(now - t_new, 0)
        local ang = gk_state.turn * lag
        local c = math.cos(ang)
        local s = math.sin(ang)
        local vx = v_new.X * c - v_new.Z * s
        local vz = v_new.X * s + v_new.Z * c
        local vy = v_new.Y
        if pos.Y > floor_y + 1.5 then
            vy = vy + gk_state.traj_gravity * lag
        end
        return Vector3.new(vx, vy, vz)
    end

    local function forecast(pos, vel, use_gravity, floor_y, gp, fwd, horizon, record, turn)
        local origin = hrp.Position
        local speed = math.max(hum.WalkSpeed, 1)
        local right = fwd and Vector3.new(-fwd.Z, 0, fwd.X)
        local p, v = pos, vel
        local intercept, t_int
        local best, best_t, best_slack = pos, 0, math.huge
        local close_p, close_t, close_dist = pos, 0, (pos - origin).Magnitude
        local catch_p, catch_t
        local reach_p, cross_p
        local pass_p, pass_t, pass_flat = nil, nil, math.huge
        local height_p, height_t
        local shot = false
        local points = record and {pos} or nil
        local last_rec = pos
        local t = 0
        local iter = 0
        local h = math.clamp(gk_state.max_step_dist / math.max(vel.Magnitude, 1), gk_state.min_step, gk_state.sim_step)
        local tackle_r = gk_state.tackle_radius
        local reach = gk_state.intercept_reach
        local max_t = gk_state.sim_max_time
        local max_iter = gk_state.max_iter
        local sample_d = gk_state.path_sample_dist
        local max_pts = gk_state.path_max_points
        local jump_reach = gk_state.jump_reach
        local jump_y = gk_state.stand_y + gk_state.jump_height_offset
        local catch_depth = gk_state.catch_depth
        local prev_p = pos
        local prev_depth
        if gp then
            prev_depth = (pos.X - gp.X) * fwd.X + (pos.Z - gp.Z) * fwd.Z
        end

        while t < horizon and iter < max_iter do
            iter = iter + 1
            t = t + h
            p, v = trajectory(pos, vel, t, use_gravity, floor_y, turn)

            if record and #points < max_pts and (p - last_rec).Magnitude >= sample_d then
                points[#points + 1] = p
                last_rec = p
            end

            local dx = p.X - origin.X
            local dz = p.Z - origin.Z
            local flat = math.sqrt(dx * dx + dz * dz)

            if not intercept and t <= max_t then
                local slack = math.max(flat - reach, 0) / speed - t
                if slack <= 0 then
                    intercept, t_int = p, t
                elseif slack < best_slack then
                    best, best_t, best_slack = p, t, slack
                end
            end

            local dy = p.Y - origin.Y
            local d3 = math.sqrt(flat * flat + dy * dy)
            if d3 < close_dist then
                close_p, close_t, close_dist = p, t, d3
            end
            if not reach_p and d3 <= tackle_r then
                reach_p = p
            end

            local airborne = (not floor_y) or p.Y > floor_y + 0.05

            if airborne and flat < pass_flat then
                pass_p, pass_t, pass_flat = p, t, flat
            end

            if not height_t and airborne and flat <= jump_reach and p.Y >= jump_y then
                height_p, height_t = p, t
            end

            if gp then
                local rx = p.X - gp.X
                local rz = p.Z - gp.Z
                local depth = rx * fwd.X + rz * fwd.Z
                if not catch_p and depth <= catch_depth then
                    local f = 1
                    if prev_depth > catch_depth then
                        f = (prev_depth - catch_depth) / (prev_depth - depth)
                    end
                    catch_p = prev_p:Lerp(p, f)
                    catch_t = t - h * (1 - f)
                end
                if depth <= 0 then
                    local f = 1
                    if prev_depth > 0 then
                        f = prev_depth / (prev_depth - depth)
                    end
                    cross_p = prev_p:Lerp(p, f)
                    local cx = cross_p.X - gp.X
                    local cz = cross_p.Z - gp.Z
                    shot = math.abs(cx * right.X + cz * right.Z) <= gk_state.goal_half_width
                    break
                end
                prev_p = p
                prev_depth = depth
            end
        end
        if record and (p - last_rec).Magnitude > 0.01 then
            points[#points + 1] = p
        end
        if not intercept then
            intercept, t_int = best, best_t
        end
        return {
            intercept = intercept,
            t_int = t_int,
            close_p = close_p,
            close_t = close_t,
            close_dist = close_dist,
            catch_p = catch_p,
            catch_t = catch_t,
            high_t = height_t,
            high_p = height_p,
            pass_p = pass_p,
            pass_t = pass_t,
            pass_flat = pass_flat,
            reach_p = reach_p,
            cross_p = cross_p,
            path = points,
            shot = shot
        }
    end

    local function jump_apex_time()
        local g = Workspace.Gravity
        local v0
        if hum.UseJumpPower then
            v0 = hum.JumpPower
        else
            v0 = math.sqrt(2 * g * hum.JumpHeight)
        end
        return v0 / g
    end

    local function clamp_to_home(target, goal, other_goal, subject_pos, lateral_on)
        if not goal then return target end
        local gp = goal.Position
        local subject_off = Vector3.new(subject_pos.X - gp.X, 0, subject_pos.Z - gp.Z).Magnitude
        local radius = subject_off > gk_state.far_distance and gk_state.home_radius_far or gk_state.home_radius
        local result = target
        local off = Vector3.new(target.X - gp.X, 0, target.Z - gp.Z)
        if off.Magnitude > radius then
            local c = off.Unit * radius
            result = Vector3.new(gp.X + c.X, target.Y, gp.Z + c.Z)
        end
        if other_goal and lateral_on then
            local fwd = Vector3.new(other_goal.Position.X - gp.X, 0, other_goal.Position.Z - gp.Z)
            if fwd.Magnitude > 0.001 then
                fwd = fwd.Unit
                local right = Vector3.new(-fwd.Z, 0, fwd.X)
                local rel = Vector3.new(result.X - gp.X, 0, result.Z - gp.Z)
                local lateral = rel:Dot(right)
                local limited = math.clamp(lateral, -gk_state.max_lateral, gk_state.max_lateral)
                result = result + right * (limited - lateral)
            end
        end
        return result
    end

    local function guard_position(goal, holder_pos, holder_vel, fallback)
        if not goal then return fallback end
        local gp = goal.Position
        local led = holder_pos + holder_vel * gk_state.holder_lead
        local to_holder = Vector3.new(led.X - gp.X, 0, led.Z - gp.Z)
        local dist = to_holder.Magnitude
        if dist < 0.001 then return fallback end
        local dir = to_holder.Unit
        local alpha = math.clamp(dist / gk_state.guard_far, 0, 1)
        local depth = gk_state.guard_max - (gk_state.guard_max - gk_state.guard_min) * alpha
        local right = Vector3.new(-dir.Z, 0, dir.X)
        local sway = math.noise(os.clock() * gk_state.sway_speed, 0.5, 0) * gk_state.sway_amount
        return Vector3.new(
            gp.X + dir.X * depth + right.X * sway,
            hrp.Position.Y,
            gp.Z + dir.Z * depth + right.Z * sway
        )
    end

    local function reset_timers()
        gk_state.ball_vel = Vector3.zero
        gk_state.jump_started_at = nil
        gk_state.jump_latch_until = 0
        gk_state.smooth_target = nil
        gk_state.moving = false
        gk_state.move_dir = Vector3.zero
        gk_state.turn = 0
        table.clear(gk_state.hist)
        clear_path()
    end

    RunService:BindToRenderStep("AutoGK", Enum.RenderPriority.Input.Value + 1, function(dt)
        if not gk_state.enabled or gk_state.pause or plr.Team == game.Teams.lobby then
            gk_state.look.Enabled = false
            reset_timers()
            return
        end

        local current_holder = gk_state.ball_holder.Value

        if current_holder == char then
            gk_state.look.Enabled = false
            reset_timers()
            return
        end

        local ball = get_ball()
        local holder_root = current_holder and current_holder:FindFirstChild("HumanoidRootPart")

        if not holder_root and not ball then
            gk_state.look.Enabled = false
            reset_timers()
            return
        end

        if hum.FloorMaterial ~= Enum.Material.Air then
            gk_state.stand_y = hrp.Position.Y
        end

        local goal = (plr.Team == game.Teams.B and gk_state.map.Bgoal) or (plr.Team == game.Teams.A and gk_state.map.Agoal)
        local other_goal = (plr.Team == game.Teams.B and gk_state.map.Agoal) or (plr.Team == game.Teams.A and gk_state.map.Bgoal)
        local ground_y = gk_state.stand_y - hum.HipHeight - hrp.Size.Y * 0.5

        local goal_pos
        local fwd
        if goal and other_goal then
            goal_pos = goal.Position
            local f = Vector3.new(other_goal.Position.X - goal_pos.X, 0, other_goal.Position.Z - goal_pos.Z)
            if f.Magnitude > 0.001 then
                fwd = f.Unit
            end
        end

        local ping = math.min(plr:GetNetworkPing() * gk_state.ping_scale, gk_state.ping_max)

        local in_terrain = ball ~= nil and ball.Parent == gk_state.terrain
        local horizon = in_terrain and gk_state.jump_horizon or gk_state.sim_max_time

        local subject_pos
        local fc
        local ball_speed = 0

        if holder_root then
            local holder_vel = holder_root.AssemblyLinearVelocity
            subject_pos = holder_root.Position + holder_vel * ping
            fc = forecast(subject_pos, holder_vel, false, nil, nil, nil, gk_state.sim_max_time, false, 0)
            clear_path()
            gk_state.ball_vel = Vector3.zero
            gk_state.turn = 0
            table.clear(gk_state.hist)
        else
            local floor_y = ground_y + ball.Size.Y * 0.5
            local derived = update_curve(ball, dt, floor_y)
            local start_vel = derived or get_ball_velocity(ball)
            local turn = derived and gk_state.turn or 0
            ball_speed = start_vel.Magnitude
            gk_state.ball_vel = start_vel

            local now = os.clock()
            local draw_now = gk_state.show_path and now - gk_state.last_path_draw >= gk_state.path_draw_interval

            local ball_pos, ball_vel = trajectory(ball.Position, start_vel, ping, true, floor_y, turn)
            subject_pos = ball_pos
            fc = forecast(ball_pos, ball_vel, true, floor_y, fwd and goal_pos, fwd, horizon, draw_now, turn)
            if draw_now then
                gk_state.last_path_draw = now
                draw_path(ball.Position, fc)
            end
        end

        local subject_dist = (hrp.Position - subject_pos).Magnitude
        local ball_dist = ball and (hrp.Position - ball.Position).Magnitude

        local need_jump = false
        if ball then
            if holder_root then
                need_jump = ball_dist <= gk_state.tackle_radius
                    and ball.Position.Y > gk_state.stand_y + gk_state.jump_height_offset
            else
                local low_ball = ball.Position.Y < gk_state.stand_y and gk_state.ball_vel.Y < gk_state.low_ball_rise
                need_jump = not low_ball
                    and fc.high_t ~= nil
                    and fc.high_t <= jump_apex_time() + gk_state.jump_early
            end
        end

        local now_j = os.clock()
        if need_jump then
            gk_state.jump_latch_until = now_j + jump_apex_time() + gk_state.jump_latch_margin
        elseif now_j < gk_state.jump_latch_until then
            need_jump = true
        end

        if need_jump then
            hum.Jump = true
            if not gk_state.jump_started_at then
                gk_state.jump_started_at = now_j
            end
        else
            gk_state.jump_started_at = nil
        end

        local fast_ball = ball_speed >= gk_state.fast_speed
        local jump_ok = (not need_jump) or fast_ball or (os.clock() - gk_state.jump_started_at >= gk_state.jump_wait)

        local shot_mode = false
        if not holder_root and fwd and fc.shot and fc.catch_p then
            local toward = -gk_state.ball_vel:Dot(fwd)
            shot_mode = toward > gk_state.shot_speed
        end

        local w = 1
        local desired = fc.intercept
        if shot_mode then
            desired = Vector3.new(fc.catch_p.X, hrp.Position.Y, fc.catch_p.Z)
        elseif holder_root and goal then
            w = math.clamp((gk_state.blend_radius - subject_dist) / (gk_state.blend_radius - gk_state.commit_radius), 0, 1)
            local guard_pos = guard_position(goal, holder_root.Position, holder_root.AssemblyLinearVelocity, fc.intercept)
            desired = guard_pos:Lerp(fc.intercept, w)
        end

        local lateral_on = subject_dist > gk_state.lateral_free_radius and not shot_mode
        local target = clamp_to_home(desired, goal, other_goal, subject_pos, lateral_on)
        local follow_rate = gk_state.guard_smooth_rate + (60 - gk_state.guard_smooth_rate) * w
        if gk_state.smooth_target then
            gk_state.smooth_target = gk_state.smooth_target:Lerp(target, 1 - math.exp(-dt * follow_rate))
        else
            gk_state.smooth_target = target
        end
        local move_target = gk_state.smooth_target

        local move_flat = Vector3.new(move_target.X - hrp.Position.X, 0, move_target.Z - hrp.Position.Z)
        local move_dist = move_flat.Magnitude
        local idle = w < 0.5
        local start_d = idle and gk_state.idle_start_distance or gk_state.stop_distance
        local stop_d = idle and gk_state.idle_stop_distance or gk_state.stop_distance

        if gk_state.moving then
            if move_dist < stop_d then
                gk_state.moving = false
            end
        elseif move_dist > start_d then
            gk_state.moving = true
        end

        local want = Vector3.zero
        if gk_state.moving and move_dist > 0.001 then
            want = move_flat.Unit
        end

        local rate = idle and gk_state.idle_smooth_rate or gk_state.engaged_smooth_rate
        gk_state.move_dir = gk_state.move_dir:Lerp(want, 1 - math.exp(-dt * rate))

        if gk_state.move_dir.Magnitude < 0.05 then
            hum:Move(Vector3.zero, false)
        else
            hum:Move(gk_state.move_dir, false)
        end

        local aim_pos
        if subject_dist <= gk_state.lock_radius or w < 0.5 or shot_mode then
            aim_pos = subject_pos
        else
            aim_pos = move_target
        end

        gk_state.look.Enabled = true
        gk_state.look.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(aim_pos.X, hrp.Position.Y, aim_pos.Z))

        local reach_now = math.min(ball_dist or math.huge, subject_dist)
        local want_tackle = false
        if holder_root then
            want_tackle = subject_dist <= gk_state.tackle_radius
        elseif ball then
            local incoming = fc.close_dist <= gk_state.tackle_radius and fc.close_t <= gk_state.tackle_lead
            want_tackle = reach_now <= gk_state.tackle_radius
                or incoming
                or (shot_mode and ball_dist <= gk_state.shot_tackle_dist)
        end

        if want_tackle then
            gk_state.last_want = os.clock()
        end
        local fire = want_tackle or os.clock() - gk_state.last_want <= gk_state.tackle_hold

        if fire and jump_ok and os.clock() - gk_state.last_tackle >= gk_state.tackle_interval then
            gk_state.last_tackle = os.clock()
            gk_state.remote:FireServer(unpack(gk_state.tackle_args))
        end
    end)

    gk_state.input_conn = UserInputService.InputBegan:Connect(function(input, game_processed)
        if game_processed then return end
        if input.KeyCode == Enum.KeyCode.V then
            gk_state.enabled = not gk_state.enabled
            update_indicator()
            if not gk_state.enabled then
                gk_state.look.Enabled = false
                reset_timers()
            end
        elseif input.KeyCode == Enum.KeyCode.B then
            gk_state.show_path = not gk_state.show_path
            if not gk_state.show_path then
                clear_path()
            end
        end
    end)

    gk_state.died_conn = hum.Died:Connect(cleanup)
    gk_state.char_added_conn = plr.CharacterAdded:Connect(cleanup)

    update_indicator()
end)
