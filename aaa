    local function draw_path(origin, fc)
        local prev = origin
        local count = 0
        local thick = gk_state.path_thickness
        for _, pt in ipairs(fc.path) do
            local delta = pt - prev
            local len = delta.Magnitude
            if len > 0.01 then
                count = count + 1
                local seg = gk_state.path_segments[count]
                if not seg then
                    seg = make_part(Vector3.new(thick, thick, 1), Color3.fromRGB(255, 255, 255), false)
                    gk_state.path_segments[count] = seg
                end
                seg.Size = Vector3.new(thick, thick, len)
                seg.CFrame = CFrame.lookAt(prev + delta * 0.5, pt)
                if seg.Parent ~= gk_state.path_folder then
                    seg.Parent = gk_state.path_folder
                end
            end
            prev = pt
        end
        for i = count + 1, gk_state.path_used do
            gk_state.path_segments[i].Parent = nil
        end
        gk_state.path_used = count
        place_marker("reach", fc.reach_p)
        place_marker("jump", fc.high_p)
