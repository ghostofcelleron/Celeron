local players = game:GetService("Players")
local run_service = game:GetService("RunService")

local local_player = players.LocalPlayer
local is_toggled = false
local pre_connection = nil
local post_connection = nil
local tracked_speed = 0

local function apply_speed(dt, increment)
	local current_char = local_player.Character
	local humanoid = current_char and current_char:FindFirstChildOfClass("Humanoid")
	local root_part = current_char and current_char:FindFirstChild("HumanoidRootPart")

	if humanoid and root_part then
		local move_dir = humanoid.MoveDirection
		if move_dir.Magnitude > 0 then
			local flat_dir = Vector3.new(move_dir.X, 0, move_dir.Z).Unit
			if increment then
				tracked_speed = math.max(tracked_speed, humanoid.WalkSpeed) + 0.12
			end
			root_part.CFrame = root_part.CFrame + (flat_dir * tracked_speed * dt)
		else
			tracked_speed = 0
		end
	end
end

local function update_speed(enabled)
	if pre_connection then
		pre_connection:Disconnect()
		pre_connection = nil
	end
	if post_connection then
		post_connection:Disconnect()
		post_connection = nil
	end

	tracked_speed = 0

	if enabled then
		pre_connection = run_service.PreSimulation:Connect(function(dt)
			apply_speed(dt, true)
		end)
		post_connection = run_service.PostSimulation:Connect(function(dt)
			apply_speed(dt, false)
		end)
	end
end

charbuffs:Toggle("God Speed (Req. On Foot)", "Greatly Increases Overall Movement Speed While Enabled.", function(v)
	if typeof(v) == "boolean" then
		is_toggled = v
	else
		is_toggled = not is_toggled
	end

	update_speed(is_toggled)
end)

local players = game:GetService("Players")
local run_service = game:GetService("RunService")
local user_input_service = game:GetService("UserInputService")

local local_player = players.LocalPlayer
local is_toggled = false
local sprint_connection = nil

local function is_mobile()
	return user_input_service.TouchEnabled and not user_input_service.KeyboardEnabled
end

local function is_shift_held()
	return user_input_service:IsKeyDown(Enum.KeyCode.LeftShift) or user_input_service:IsKeyDown(Enum.KeyCode.RightShift)
end

local function is_moving()
	local character = local_player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.MoveDirection.Magnitude > 0
end

local function get_player_rig()
	local rigs_folder = workspace:FindFirstChild("Rigs")
	return rigs_folder and rigs_folder:FindFirstChild(local_player.Name)
end

local function update_sprint(enabled)
	if sprint_connection then
		sprint_connection:Disconnect()
		sprint_connection = nil

		local player_rig = get_player_rig()
		if player_rig then
			player_rig:SetAttribute("SlowMode", 1)
		end
	end

	if enabled then
		sprint_connection = run_service.Heartbeat:Connect(function()
			local player_rig = get_player_rig()
			if not player_rig then
				return
			end

			local should_boost
			if is_mobile() then
				should_boost = is_moving()
			else
				should_boost = is_shift_held()
			end

			if should_boost then
				player_rig:SetAttribute("SlowMode", 2)
			else
				player_rig:SetAttribute("SlowMode", 1)
			end
		end)
	end
end

charbuffs:Toggle("Infinite Sprint (Req. On Foot)", "When Enabled, You Have Infinite Sprinting. Simple Enough.", function(v)
	if typeof(v) == "boolean" then
		is_toggled = v
	else
		is_toggled = not is_toggled
	end

	update_sprint(is_toggled)
end)

