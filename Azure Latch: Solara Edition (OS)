local targets = {A = Vector3.new(-370, 13, -1598), B = Vector3.new(-195, 13, -1598)}
local player = game:GetService("Players").LocalPlayer
local vim = game:GetService("VirtualInputManager")
local gui_service = game:GetService("GuiService")
local states = {}

local function click(btn)
    if not btn then return end
    pcall(function()
        local abs_pos = btn.AbsolutePosition
        local abs_size = btn.AbsoluteSize
        local inset = gui_service:GetGuiInset()
        
        local click_x = abs_pos.X + (abs_size.X / 2) + inset.X
        local click_y = abs_pos.Y + (abs_size.Y / 2) + inset.Y
        
        vim:SendMouseButtonEvent(click_x, click_y, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(click_x, click_y, 0, false, game, 0)
    end)
end

local function run_seq(pos)
    local pgui = player:WaitForChild("PlayerGui", 15)
    if not pgui or not states[pos] then return end

    local lobby = pgui:WaitForChild("Lobby", 15)
    local frame = lobby and lobby:WaitForChild("Frame", 15)
    local play_frame = frame and frame:WaitForChild("Play", 15)
    local play = play_frame and play_frame:WaitForChild("Button", 15)

    if play then
        while states[pos] do
            if play.Visible and play.AbsoluteSize.X > 0 then
                click(play)
                break
            end
            task.wait(0.1)
        end
    end

    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 15)
    if not root then return end

    while root.Position == Vector3.new(0, 0, 0) or (root.Position - Vector3.new(0, 0, 0)).Magnitude < 5 do
        if not states[pos] then return end
        task.wait(0.1)
    end

    for side, target_pos in pairs(targets) do
        if (root.Position - target_pos).Magnitude <= 15 then
            while states[pos] do
                local select_gui = pgui:FindFirstChild("Select")
                local select_frame = select_gui and select_gui:FindFirstChild("Frame")
                local side_frame = select_frame and select_frame:FindFirstChild(side)
                local pos_frame = side_frame and side_frame:FindFirstChild(pos)
                local btn = pos_frame and pos_frame:FindFirstChild("Button")
                
                if btn and btn.Visible and btn.AbsoluteSize.X > 0 then
                    task.wait(0.5)
                    click(btn)
                    break
                end
                task.wait(0.1)
            end
            break
        end
    end
end

