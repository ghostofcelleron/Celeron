    getgenv().applySpeed()
end)

getgenv().last_jump_set = getgenv().last_jump_set or 50
getgenv().jump_boost_enabled = true
getgenv().jump_conn = nil

local players = game:GetService("Players")
local debris = game:GetService("Debris")
local starter_gui = game:GetService("StarterGui")
local user_input_service = game:GetService("UserInputService")
local lp = players.LocalPlayer

local infinite_jump_enabled = false
local original_settings = setmetatable({}, {__mode = "k"})

local function apply_jump_boost(hum, hrp)
	if getgenv().jump_conn then
		getgenv().jump_conn:Disconnect()
		getgenv().jump_conn = nil
	end

	getgenv().jump_conn = hum.StateChanged:Connect(function(_, new_state)
		if new_state == Enum.HumanoidStateType.Jumping and getgenv().jump_boost_enabled and getgenv().last_jump_set > 0 then
			local jump_velocity = math.sqrt(2 * workspace.Gravity * getgenv().last_jump_set)
			local boost = Instance.new("BodyVelocity")
			boost.MaxForce = Vector3.new(0, 1e5, 0)
			boost.Velocity = Vector3.new(0, jump_velocity, 0)
			boost.P = 1e4
			boost.Parent = hrp
			debris:AddItem(boost, 0.2)
		end
	end)
end

getgenv().apply_jump = function()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp then
		if not original_settings[hum] then
			original_settings[hum] = {
				use_jump_power = hum.UseJumpPower,
				jump_height = hum.JumpHeight,
				jump_power = hum.JumpPower,
			}
		end

		local saved = original_settings[hum]
		if getgenv().last_jump_set > 0 then
			hum.UseJumpPower = false
			hum.JumpHeight = getgenv().last_jump_set
		else
			hum.JumpHeight = saved.jump_height
			hum.JumpPower = saved.jump_power
			hum.UseJumpPower = saved.use_jump_power
		end

		apply_jump_boost(hum, hrp)
	end
end

maintab:Slider("Jump Boost", 50, 0, 60, 1, function(v)
