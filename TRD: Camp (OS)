gametab:Label("Sword Fighting Minigame: Allows You To Have Reach On Your Sword.")

local reachEnabled = false
local reachRadius = 0
local originalGrips = {}
local reachConnection = nil
local selectionBox = nil

local function getSelectionBox()
    if selectionBox and selectionBox.Parent then return selectionBox end
    if selectionBox then selectionBox:Destroy() end
    
    selectionBox = Instance.new("SelectionBox")
    selectionBox.Name = "ReachVisual"
    selectionBox.Color3 = Color3.fromRGB(255, 0, 100)
    selectionBox.LineThickness = 0.05
    selectionBox.SurfaceTransparency = 0.85
    selectionBox.SurfaceColor3 = Color3.fromRGB(255, 0, 100)
    return selectionBox
end

local function removeSelectionBox()
    if selectionBox then
        selectionBox:Destroy()
        selectionBox = nil
    end
end

local function getWeaponHandle(tool)
    return tool:FindFirstChild("Handle")
end

local function applyReach(tool)
    if not reachEnabled or not tool:IsA("Tool") then return end
    local handle = getWeaponHandle(tool)
    if not handle or not handle:IsA("BasePart") then return end

    if not originalGrips[tool] then
        originalGrips[tool] = {
            grip = tool.Grip,
            size = handle.Size,
            transparency = handle.Transparency
        }
    end

    handle.Massless = true
    handle.CanCollide = false
    handle.Size = Vector3.new(reachRadius, reachRadius, reachRadius)
    handle.Transparency = 1
    
    local box = getSelectionBox()
    box.Adornee = handle
    box.Parent = handle
    
    tool.Grip = originalGrips[tool].grip
end

local function removeReach(tool)
    removeSelectionBox()
    local data = originalGrips[tool]
    if not data then return end
    
    local handle = getWeaponHandle(tool)
    if handle and handle:IsA("BasePart") then
        handle.Size = data.size
        handle.Transparency = data.transparency
    end
    
    tool.Grip = data.grip
    originalGrips[tool] = nil
end

local function manageReachLoop()
    if reachConnection then
        reachConnection:Disconnect()
        reachConnection = nil
    end

    if not reachEnabled then
        removeSelectionBox()
        local char = player.Character
        if char then
            local currentTool = char:FindFirstChildOfClass("Tool")
            if currentTool then removeReach(currentTool) end
        end
        return
    end

    reachConnection = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if not char then 
            removeSelectionBox()
            return 
        end

        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool then
            applyReach(currentTool)
        end
    end)
end

gametab:Toggle("Weapon Reach", "Attaches Reach To Your Sword, Enable While Holding Sword.", function(state)
    reachEnabled = state

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Weapon Reach",
        Text = state and "Enabled." or "Disabled.",
        Duration = 3
    })

    manageReachLoop()
end)

gametab:Slider("Weapon Reach Radius", 0, 0, 50, 1, function(v)
    reachRadius = v
    if reachEnabled then
        local char = player.Character
        if char then
            local currentTool = char:FindFirstChildOfClass("Tool")
            if currentTool then applyReach(currentTool) end
        end
    end
end)

