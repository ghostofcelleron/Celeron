local tbl = {}
local NetworkPacket = require(game:GetService("ReplicatedStorage"):WaitForChild("Network"):WaitForChild("NetworkPacket"))

-- Helper utility to extract IDs from the new ByteNet structure
local function getPacketId(name)
    local packet = NetworkPacket[name]
    if packet and type(packet) == "table" then
        return packet.id or packet._id or packet.packetId
    end
    -- Fallback sequence loop
    for k, v in pairs(NetworkPacket) do
        if type(v) == "table" and (v.name == name or k == name) then
            return v.id or v._id or v.packetId
        end
    end
    return nil
end

local baseNum = getPacketId("bytenet_use")
local grabballNum = getPacketId("bytenet_findBall")

if baseNum then
	tbl.base = string.char(baseNum, 1, 0)
end

if grabballNum then
	tbl.grabball = string.char(grabballNum)
end

local function encode(s)
	local t = {}
	for i = 1, #s do
		t[i] = s:byte(i)
	end
	return table.concat(t, ",")
end

local function decode(s)
	local t = {}
	for n in s:gmatch("%d+") do
		table.insert(t, string.char(tonumber(n)))
	end
	return table.concat(t)
end

local function show(s)
	local bytes = {}
	for i = 1, #s do
		table.insert(bytes, string.format("\\%03d", s:byte(i)))
	end
	return table.concat(bytes) .. " (" .. #s .. " bytes)"
end

local folder = Instance.new("Folder")
folder.Name = "BUFFERSTRINGS"

for i, v in pairs(tbl) do
	print(i, "built:", show(v))
	local val = Instance.new("StringValue")
	val.Value = encode(v)
	val.Name = i
	val.Parent = folder
end

folder.Parent = game.Lighting

for _, val in ipairs(folder:GetChildren()) do
	print(val.Name, "stored:", val.Value, "-> decoded:", show(decode(val.Value)))
end
