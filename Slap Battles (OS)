local workspace_service = game:GetService("Workspace")
local run_service = game:GetService("RunService")
local starter_gui = game:GetService("StarterGui")
local virtual_input_manager = game:GetService("VirtualInputManager")
local player = game:GetService("Players").LocalPlayer

local hit_targets = {
    ReplicaNPC = {part_name = "Right Arm", enabled = false},
    TrackGloveMissile = {part_name = "self", enabled = false},
    golem = {part_name = "Hitbox", enabled = false},
    GuideNPC = {part_name = "Right Arm", enabled = false}
}

if getgenv().auto_hit_connections then
    for _, connection in ipairs(getgenv().auto_hit_connections) do
        connection:Disconnect()
    end
end

local tracked = {}

local function track(instance)
    if hit_targets[instance.Name] then
        tracked[instance] = true
    end
end

local function get_target(instance)
    local part_name = hit_targets[instance.Name].part_name

    if part_name == "self" then
        return instance
    end

    return instance:FindFirstChild(part_name)
end

local function get_network()
    local character = player.Character
    local lantern = character and character:FindFirstChild("Lantern")

    return lantern and lantern:FindFirstChild("Network")
end

local function click()
    local viewport_size = workspace_service.CurrentCamera.ViewportSize
    local click_x = viewport_size.X / 2
    local click_y = viewport_size.Y / 2

    virtual_input_manager:SendMouseButtonEvent(click_x, click_y, 0, true, game, 0)
    virtual_input_manager:SendMouseButtonEvent(click_x, click_y, 0, false, game, 0)
end

local function toggle_target(title, target_name)
    local target_data = hit_targets[target_name]
    target_data.enabled = not target_data.enabled

    starter_gui:SetCore("SendNotification", {
        Title = title,
        Text = target_data.enabled and "Enabled." or "Disabled.",
        Duration = 1
    })
end

for _, instance in ipairs(workspace_service:GetChildren()) do
    track(instance)
end

getgenv().auto_hit_connections = {
    workspace_service.ChildAdded:Connect(track),
    workspace_service.ChildRemoved:Connect(function(instance)
        tracked[instance] = nil
    end),
    run_service.Heartbeat:Connect(function()
        local network = get_network()

        if not network then
            return
        end

        local fired = false

        for instance in pairs(tracked) do
            if hit_targets[instance.Name].enabled then
                local target = get_target(instance)

                if target then
                    network:FireServer("Hit", target)
                    fired = true
                end
            end
        end

        if fired then
            click()
        end
    end)
}

