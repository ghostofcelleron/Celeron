getgenv().bounty_listener_id = (getgenv().bounty_listener_id or 0) + 1
local listener_run_id = getgenv().bounty_listener_id

task.spawn(function()
	local players_service = game:GetService("Players")
	local replicated_storage = game:GetService("ReplicatedStorage")
	local local_player = players_service.LocalPlayer
	local slap_remote = replicated_storage:WaitForChild("b")

	local function get_target_torso(name)
		local target_player = players_service:FindFirstChild(name)
		local target_character = target_player and target_player.Character
		return target_character and target_character:FindFirstChild("Torso")
	end

	local function get_my_root()
		local my_character = local_player.Character
		return my_character and my_character:FindFirstChild("HumanoidRootPart")
	end

	local function read_bounty(name)
		local target_model = workspace:FindFirstChild(name)
		local billboard = target_model and target_model:FindFirstChild("bounty_billboard")
		local label = billboard and billboard:FindFirstChild("TextLabel")
		local cleaned_text = label and string.gsub(label.Text, ",", "")
		return cleaned_text and tonumber(string.match(cleaned_text, "%d+"))
	end

	local function slap_attempt(name)
		local follow_end = os.clock() + 1
		repeat
			local torso, my_root = get_target_torso(name), get_my_root()
			if torso and my_root then
				my_root.CFrame = torso.CFrame * CFrame.new(0, 0, 3)
				my_root.AssemblyLinearVelocity = Vector3.zero
			end
			task.wait(0.05)
		until os.clock() >= follow_end

		local torso, my_root = get_target_torso(name), get_my_root()
		if not (torso and my_root) then return false end

		for _ = 1, 3 do
			my_root.CFrame = torso.CFrame * CFrame.new(0, 0, 3)
			pcall(function()
				slap_remote:FireServer(torso)
			end)
		end

		task.wait(0.5)

		local after = read_bounty(name)
		return torso.Parent == nil or after == nil or after < 1000
	end

	while getgenv().bounty_listener_id == listener_run_id do
		task.wait(0.1)
		local target_name = bounty_listener.target_name
		if target_name ~= "" then
			local bounty_value = read_bounty(target_name)
			if bounty_value and bounty_value >= 1000 and os.clock() - bounty_listener.last_fire >= bounty_listener.cooldown then
				task.wait(3)
				for _ = 1, 3 do
					if slap_attempt(target_name) then break end
					task.wait(0.3)
				end
				bounty_listener.last_fire = os.clock()
			end
		end
	end
end)

