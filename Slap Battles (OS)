combat:Toggle("Slap Aura (Legit)", function()
	getgenv().legitslapaura.enabled = not getgenv().legitslapaura.enabled

	if getgenv().legitslapaura.enabled and not getgenv().legitslapaura.connection then
		start_pause_watcher()

		getgenv().legitslapaura.connection = game:GetService("RunService").Heartbeat:Connect(function()
			local now = os.clock()
			if now - getgenv().legitslapaura.slap_window_start > getgenv().legitslapaura.window_duration then
				getgenv().legitslapaura.slap_window_start = now
				getgenv().legitslapaura.slap_count = 0
			end
			if getgenv().legitslapaura.slap_count >= getgenv().legitslapaura.max_slaps_per_window or getgenv().legitslapaura.cooldown_active then return end

			if is_paused() then return end
			if is_ragdolled() then return end

			local char = game:GetService("Players").LocalPlayer.Character
			local glove = char and char:FindFirstChildOfClass("Tool")
			if not glove then return end

			local my_root = char:FindFirstChild("HumanoidRootPart")
			if not my_root then return end

			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if not humanoid then return end

			local closest, dist = nil, math.huge
			for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
				if p ~= game:GetService("Players").LocalPlayer
					and p.Character
					and p.Character:FindFirstChild("HumanoidRootPart")
					and not has_spectator(p) then
					local mag = (p.Character.HumanoidRootPart.Position - my_root.Position).Magnitude
					if mag < dist then
						dist = mag
						closest = p
					end
				end
			end
			if not (closest and closest.Character) then return end

			local torso = closest.Character:FindFirstChild("Torso") or closest.Character:FindFirstChild("UpperTorso") or closest.Character:FindFirstChild("HumanoidRootPart")
			if not torso then return end

			if dist > getgenv().legitslapaura.max_distance then return end
			local y = my_root.Position.Y
			if y >= getgenv().legitslapaura.y_block_min and y <= getgenv().legitslapaura.y_block_max then return end

			getgenv().legitslapaura.cooldown_active = true
			task.delay(getgenv().legitslapaura.cooldown_time, function()
				getgenv().legitslapaura.cooldown_active = false
			end)

			local remotes = find_legit_remotes(glove.Name)

			local original_rotation = my_root.CFrame.Rotation
			local original_auto_rotate = humanoid.AutoRotate
			humanoid.AutoRotate = false

			local attachment = Instance.new("Attachment")
			attachment.Name = "legitslapaura_attachment"
			attachment.Parent = my_root

			local align = Instance.new("AlignOrientation")
			align.Name = "legitslapaura_align"
			align.Mode = Enum.OrientationAlignmentMode.OneAttachment
			align.Attachment0 = attachment
			align.MaxTorque = math.huge
			align.Responsiveness = getgenv().legitslapaura.align_responsiveness
			align.RigidityEnabled = false
			align.CFrame = original_rotation
			align.Parent = my_root

			local jitter = getgenv().legitslapaura.flick_tween_jitter
			local flick_time = math.max(getgenv().legitslapaura.flick_tween_time + math.random() * jitter, 0.001)

			local state = {
				get_goal = function()
					return get_aim_rotation(my_root, torso)
				end,
				from_rotation = original_rotation,
				phase_start = os.clock(),
				phase_duration = flick_time
			}

			local step_name = "legitslapaura_orientation"
			game:GetService("RunService"):BindToRenderStep(step_name, Enum.RenderPriority.Camera.Value + 1, function()
				if not my_root.Parent then return end
				local alpha = math.clamp((os.clock() - state.phase_start) / state.phase_duration, 0, 1)
				local goal = state.get_goal()
				align.CFrame = goal
				if is_shiftlock_active() then
					my_root.CFrame = CFrame.new(my_root.Position) * state.from_rotation:Lerp(goal, alpha)
				end
			end)

			task.wait(flick_time)

			local blocked_now = is_ragdolled() or is_paused()

			if not blocked_now then
				for _, r in ipairs(remotes) do
					r:FireServer(torso)
				end
			end

			if not blocked_now and (y < getgenv().legitslapaura.y_block_min or y > getgenv().legitslapaura.y_block_max) then
				local virtual_input = game:GetService("VirtualInputManager")
				local mouse_location = game:GetService("UserInputService"):GetMouseLocation()
				virtual_input:SendMouseButtonEvent(mouse_location.X, mouse_location.Y, 0, true, game, 0)
				task.wait(getgenv().legitslapaura.click_hold_time)
				virtual_input:SendMouseButtonEvent(mouse_location.X, mouse_location.Y, 0, false, game, 0)
			end

			if my_root.Parent then
				state.from_rotation = my_root.CFrame.Rotation
				state.get_goal = function()
					if is_shiftlock_active() then
						return get_camera_rotation(original_rotation)
					end
					return original_rotation
				end
				state.phase_start = os.clock()
				state.phase_duration = math.max(getgenv().legitslapaura.flick_return_time, 0.001)
				task.wait(getgenv().legitslapaura.flick_return_time)
			end

			game:GetService("RunService"):UnbindFromRenderStep(step_name)
			align:Destroy()
			attachment:Destroy()
			if humanoid.Parent then
				humanoid.AutoRotate = original_auto_rotate
			end

			getgenv().legitslapaura.slap_count += 1
		end)
	elseif not getgenv().legitslapaura.enabled and getgenv().legitslapaura.connection then
		getgenv().legitslapaura.connection:Disconnect()
		getgenv().legitslapaura.connection = nil
		stop_pause_watcher()
	end

	game:GetService("StarterGui"):SetCore("SendNotification", {
		Title = "Slap Aura (Legit)",
		Text = getgenv().legitslapaura.enabled and "Enabled." or "Disabled.",
		Duration = 3
	})
end)

