local function get_aim_rotation(my_root, torso)
	local direction = Vector3.new(torso.Position.X - my_root.Position.X, 0, torso.Position.Z - my_root.Position.Z)
	if direction.Magnitude < 0.001 then
		return my_root.CFrame.Rotation
	end
	return CFrame.lookAt(Vector3.zero, direction)
end

local function get_camera_rotation(fallback_rotation)
	local camera = workspace.CurrentCamera
	if not camera then
		return fallback_rotation
	end
	local look = camera.CFrame.LookVector
	local flat_look = Vector3.new(look.X, 0, look.Z)
	if flat_look.Magnitude < 0.001 then
		return fallback_rotation
	end
	return CFrame.lookAt(Vector3.zero, flat_look)
end

local function is_ragdolled()
	local lp = game:GetService("Players").LocalPlayer
	local model = workspace:FindFirstChild(lp.Name)
	if not model then return false end
	local flag = model:FindFirstChild("Ragdolled")
	if flag and flag:IsA("ValueBase") then
		return flag.Value == true
	end
	return model:GetAttribute("Ragdolled") == true
end

local function is_paused()
	return os.clock() < getgenv().legitslapaura.paused_until
end

local function watch_animator(animator)
	local cfg = getgenv().legitslapaura
	local conn = animator.AnimationPlayed:Connect(function(track)
		local anim = track.Animation
		if anim and string.find(anim.AnimationId, cfg.pause_animation_id, 1, true) then
			cfg.paused_until = os.clock() + cfg.pause_duration
		end
	end)
	table.insert(cfg.anim_connections, conn)
end

local function stop_pause_watcher()
	local cfg = getgenv().legitslapaura
	for _, conn in ipairs(cfg.anim_connections) do
		conn:Disconnect()
	end
	cfg.anim_connections = {}
end

local function watch_character(character)
	local cfg = getgenv().legitslapaura

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Animator") then
			watch_animator(obj)
		end
	end

	table.insert(cfg.anim_connections, character.DescendantAdded:Connect(function(obj)
		if obj:IsA("Animator") then
			watch_animator(obj)
		end
	end))
end

local function watch_player(player)
	local cfg = getgenv().legitslapaura
	if player == game:GetService("Players").LocalPlayer then return end

	if player.Character then
		watch_character(player.Character)
	end

	table.insert(cfg.anim_connections, player.CharacterAdded:Connect(watch_character))
end

local function start_pause_watcher()
	stop_pause_watcher()
	local cfg = getgenv().legitslapaura
	local players = game:GetService("Players")

	for _, player in ipairs(players:GetPlayers()) do
		watch_player(player)
	end

	table.insert(cfg.anim_connections, players.PlayerAdded:Connect(watch_player))
end

