local tbl = {}

local info = game.ReplicatedStorage.BytenetStorage.Networking.Value

local useNum = info:match('"bytenet_use"%s*:%s*(%d+)')
local grabballNum = info:match('"bytenet_findBall"%s*:%s*(%d+)')

if useNum then
	tbl.use = string.char(tonumber(useNum)) .. "\001\000"
end

if grabballNum then
	tbl.grabball = string.char(tonumber(grabballNum))
end

local folder = Instance.new("Folder")
folder.Name = "BUFFERSTRINGS"

for i, v in pairs(tbl) do
	local val = Instance.new("StringValue")
	val.Value = v
	val.Name = i
	val.Parent = folder
end

folder.Parent = game.Lighting

-- print what was stored
if next(tbl) == nil then
	warn("Nothing found in BytenetStorage.Networking.Value")
end

for _, val in ipairs(folder:GetChildren()) do
	local s = val.Value
	local bytes = {}
	for i = 1, #s do
		table.insert(bytes, string.format("\\%03d", s:byte(i)))
	end
	print(val.Name, table.concat(bytes), "(" .. #s .. " bytes)")
end
