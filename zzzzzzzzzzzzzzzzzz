local tbl = {}

local info = game.ReplicatedStorage.BytenetStorage.Networking.Value

local baseNum = info:match('"bytenet_use"%s*:%s*(%d+)')
local grabballNum = info:match('"bytenet_findBall"%s*:%s*(%d+)')

if baseNum then
	tbl.base = {tonumber(baseNum), 1, 0}
end

if grabballNum then
	tbl.grabball = {tonumber(grabballNum)}
end

local folder = Instance.new("Folder")
folder.Name = "BUFFERSTRINGS"

for i, v in pairs(tbl) do
	local val = Instance.new("StringValue")
	val.Value = string.char(table.unpack(v))
	val.Name = i
	val.Parent = folder

	local bytes = Instance.new("StringValue")
	bytes.Value = table.concat(v, ",")
	bytes.Name = i .. "_bytes"
	bytes.Parent = folder
end

folder.Parent = game.Lighting
